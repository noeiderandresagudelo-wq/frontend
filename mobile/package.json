{
  "name": "alarvix-android",
  "private": true,
  "version": "1.0.0",
  "description": "Aplicación Android de Alarvix Enterprise con GPS en segundo plano.",
  "scripts": {
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:build": "npx cap sync android && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor-community/background-geolocation": "^1.2.26"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9"
  }
}
